# Рабочие артефакты лаунчера (создаются при работе, не для репозитория)
__pycache__/
*.pyc
pac_unpacked/
pac_packed/
tbl_to_json/
json_to_tbl/
data_to_py/
data_to_py_DECOMPILE/
py_to_data/
_pack_script/
selftest_work/
chunks/
xliff/
strings.tsv
data_game_strings.xliff
LogDisassembler.txt
/*.tbl
/*.json

# Копии карт переводов, которые создаёт tools/scene_set.py, apply_ru.py и
# волновые правки. Маска ".bak*" ловит все варианты имени (.bak, .bak_123456,
# .bak_wave3, .bak_tags2, .bak_audit_pre — они весят ~9 МБ каждый).
translation_map/*.bak*
# Метка-замок рабочей сессии, живёт только во время правки карт.
translation_map/EDIT_LOCK

# Карты перевода содержат исходный японский текст игры построчно — решение
# владельца: в публичный репозиторий идёт только инструмент, без текста игры.
# Индекс карт (MAP_INDEX.csv) — это только ID и пути, японского текста в нём
# нет, поэтому он публикуется.
translation_map/*.jsonl

# Черновики переводов и заготовки — промежуточные: перевод живёт в translation_map/.
# ВАЖНО: игнорировать каталоги целиком нельзя — агенты (и любые инструменты,
# уважающие .gitignore) перестают ЧИТАТЬ заготовки и черновики, и волна
# перевода встаёт. Поэтому игнорируем файлы по маске, а каталоги оставляем
# видимыми. Перед публикацией репозитория эти файлы всё равно достаточно не
# добавлять в коммит.
#
# ИСКЛЮЧЕНИЕ (решение владельца репозитория): в публичный репозиторий идёт
# только инструмент, без текста игры. Поэтому каталоги, в которых лежит
# ИСХОДНЫЙ ЯПОНСКИЙ ТЕКСТ игры или его построчный перевод (черновики,
# постановки сцен, дампы для аудита), закрыты целиком, вместе с каталогом.
# Побочный эффект: агенты по этим каталогам больше не читают файлы — при
# работе над волной перевода маску нужно временно снять (или перенести
# правило в .git/info/exclude).
tools/drafts/*.json
tools/drafts/*.bak_raw
tools/drafts/**/*.json
tools/scene_ru/*.json
tools/_*.log
tools/_*.txt
tools/_wave*/
tools/drafts/
tools/scene_ru/
tools/audit_parts/
tools/audit_reports/

# Архив прошедших волн (вход/выход воркеров, merge-скрипты, логи). Переводы
# из него уже лежат в translation_map/, сам архив только для истории — целиком
# игнорируем каталог, чтобы в публичный репозиторий не утекал рабочий мусор.
tools/drafts/_applied/

# Сторонний редактор ассетов (52 МБ, чужой бинарник, к нашему коду отношения не
# имеет) — в публичный репозиторий не идёт.
DDS Editor/

# Файлы-замки Excel/Word ("~$имя.xlsx"), остаются от открытых документов.
~$*
